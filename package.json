{
  "name": "issue-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:ui",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json --env-file-if-exists=.env.local src/server/dev.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "fix": "pnpm run format:fix && pnpm run lint:fix",
    "typecheck": "tsc -b",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "test:coverage": "vitest run --coverage --typecheck"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@vercel/blob": "2.9.0",
    "hono": "4.13.13",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@oxlint/plugins": "1.89.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "0.14.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "chain-mock": "0.2.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "jsdom": "30.1.3",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
