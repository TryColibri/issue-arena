# Copy to .env.local for `pnpm dev`. On Vercel these are project env vars.

# Linear OAuth app (https://linear.app/settings/api/applications/new).
# Callback URLs: http://localhost:5173/api/auth/linear/callback and
# https://<your-domain>/api/auth/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# At least 32 random characters: `openssl rand -base64 32`.
SESSION_SECRET=

# Optional: comma-separated Linear workspace IDs allowed to sign in. Empty
# allows every workspace. Defense in depth behind Vercel Deployment Protection.
ALLOWED_LINEAR_ORG_IDS=

# Optional: private Blob store for arenas. Without it `pnpm dev` keeps arenas
# in memory. Get it with `vercel env pull .env.local`.
# BLOB_READ_WRITE_TOKEN=
